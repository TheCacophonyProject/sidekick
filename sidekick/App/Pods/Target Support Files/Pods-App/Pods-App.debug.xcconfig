ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Capacitor" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorApp" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorBrowser" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCamera" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorClipboard" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCommunityKeepAwake" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCommunitySqlite" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCordova" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorDialog" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorFilesystem" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorGeolocation" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorIosAutofillSavePassword" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorLocalNotifications" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorNativeSettings" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorNetwork" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorPreferences" "${PODS_CONFIGURATION_BUILD_DIR}/SQLCipher" "${PODS_CONFIGURATION_BUILD_DIR}/Sentry" "${PODS_CONFIGURATION_BUILD_DIR}/SentryCapacitor" "${PODS_CONFIGURATION_BUILD_DIR}/ZIPFoundation" "${PODS_ROOT}/../../shared/build/cocoapods/framework" "${PODS_ROOT}/IONFilesystemLib" "${PODS_ROOT}/IONGeolocationLib" "${PODS_XCFRAMEWORKS_BUILD_DIR}/IONFilesystemLib" "${PODS_XCFRAMEWORKS_BUILD_DIR}/IONGeolocationLib"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1 SQLITE_HAS_CODEC=1 _SQLITE3_H_=1 _FTS5_H=1 _SQLITE3RTREE_H_=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Capacitor/Capacitor.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorApp/CapacitorApp.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorBrowser/CapacitorBrowser.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCamera/CapacitorCamera.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorClipboard/CapacitorClipboard.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCommunityKeepAwake/CapacitorCommunityKeepAwake.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCommunitySqlite/CapacitorCommunitySqlite.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCordova/Cordova.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorDialog/CapacitorDialog.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorFilesystem/CapacitorFilesystem.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorGeolocation/CapacitorGeolocation.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorIosAutofillSavePassword/CapacitorIosAutofillSavePassword.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorLocalNotifications/CapacitorLocalNotifications.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorNativeSettings/CapacitorNativeSettings.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorNetwork/CapacitorNetwork.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorPreferences/CapacitorPreferences.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SQLCipher/SQLCipher.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Sentry/Sentry.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SentryCapacitor/SentryCapacitor.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ZIPFoundation/ZIPFoundation.framework/Headers" $(PODS_ROOT)/SQLCipher
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_CFLAGS = $(inherited) -DSQLITE_HAS_CODEC -DSQLITE_TEMP_STORE=2 -DSQLITE_SOUNDEX -DSQLITE_THREADSAFE -DSQLITE_ENABLE_RTREE -DSQLITE_ENABLE_STAT3 -DSQLITE_ENABLE_STAT4 -DSQLITE_ENABLE_COLUMN_METADATA -DSQLITE_ENABLE_MEMORY_MANAGEMENT -DSQLITE_ENABLE_LOAD_EXTENSION -DSQLITE_ENABLE_FTS4 -DSQLITE_ENABLE_FTS4_UNICODE61 -DSQLITE_ENABLE_FTS3_PARENTHESIS -DSQLITE_ENABLE_UNLOCK_NOTIFY -DSQLITE_ENABLE_JSON1 -DSQLITE_ENABLE_FTS5 -DSQLCIPHER_CRYPTO_CC -DHAVE_USLEEP=1 -DSQLITE_MAX_VARIABLE_NUMBER=99999 -DSQLITE_EXTRA_INIT=sqlcipher_extra_init -DSQLITE_EXTRA_SHUTDOWN=sqlcipher_extra_shutdown
OTHER_LDFLAGS = $(inherited) -l"c++" -framework "Capacitor" -framework "CapacitorApp" -framework "CapacitorBrowser" -framework "CapacitorCamera" -framework "CapacitorClipboard" -framework "CapacitorCommunityKeepAwake" -framework "CapacitorCommunitySqlite" -framework "CapacitorDialog" -framework "CapacitorFilesystem" -framework "CapacitorGeolocation" -framework "CapacitorIosAutofillSavePassword" -framework "CapacitorLocalNotifications" -framework "CapacitorNativeSettings" -framework "CapacitorNetwork" -framework "CapacitorPreferences" -framework "Cordova" -framework "Foundation" -framework "IONFilesystemLib" -framework "IONGeolocationLib" -framework "SQLCipher" -framework "Security" -framework "Sentry" -framework "SentryCapacitor" -framework "WebKit" -framework "ZIPFoundation" -framework "shared"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/Capacitor" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorApp" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorBrowser" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCamera" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorClipboard" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCommunityKeepAwake" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCommunitySqlite" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCordova" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorDialog" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorFilesystem" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorGeolocation" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorIosAutofillSavePassword" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorLocalNotifications" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorNativeSettings" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorNetwork" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorPreferences" "-F${PODS_CONFIGURATION_BUILD_DIR}/IONFilesystemLib" "-F${PODS_CONFIGURATION_BUILD_DIR}/IONGeolocationLib" "-F${PODS_CONFIGURATION_BUILD_DIR}/SQLCipher" "-F${PODS_CONFIGURATION_BUILD_DIR}/Sentry" "-F${PODS_CONFIGURATION_BUILD_DIR}/SentryCapacitor" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZIPFoundation" "-F${PODS_CONFIGURATION_BUILD_DIR}/shared"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
